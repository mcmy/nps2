# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS builder
ARG GOPROXY=https://proxy.golang.org
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /go/src/github.com/mcmy/nps2
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOPROXY="$GOPROXY" go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    target_goarm=""; \
    if [ -n "$TARGETVARIANT" ]; then target_goarm="${TARGETVARIANT#v}"; fi; \
    export CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH"; \
    if [ -n "$target_goarm" ]; then export GOARM="$target_goarm"; fi; \
    go build -trimpath -buildvcs=false -ldflags="-s -w" ./cmd/npc/npc.go

FROM alpine
RUN apk add --no-cache tzdata nano ca-certificates && update-ca-certificates
COPY --from=builder /go/src/github.com/mcmy/nps2/npc /
VOLUME /conf
ENTRYPOINT ["/npc"]
